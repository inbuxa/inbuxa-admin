# Settings for `npm run dev`. Put your own in .env.development.local, which
# git ignores; it overrides these.

# The server the dev console talks to.
VITE_API_BASE_URL=http://localhost:8080
VITE_OAUTH_SCOPES=
# A token that skips signing in, for a server set up to accept it.
#VITE_ACCESS_TOKEN=

# Console logging of JMAP traffic and form changes (src/lib/debug.ts). Any
# value but empty, 0 or false turns it on; builds for production never log.
VITE_DEBUG_JMAP=true
VITE_DEBUG_FORMS=true
